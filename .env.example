# DeepSeek API Key (required)
# Sign up at https://platform.deepseek.com to get your API key
DEEPSEEK_API=sk-your-api-key-here

# Base URL for DeepSeek API (optional — default: https://api.deepseek.com)
BASE_URL="https://api.deepseek.com"

# Main reasoning model for the agent (optional — default: deepseek-v4-pro)
DEFAULT_PRO_MODEL="deepseek-v4-pro"

# Flash model used for conversation compaction (optional — default: deepseek-v4-flash)
DEFAULT_FLASH_MODEL="deepseek-v4-flash"

# Log level for the tracing subscriber (optional — default: info).
# Logs write to .loomis/logs/loomis.log with daily rotation.
# Accepts tracing-subscriber EnvFilter syntax:
#   "info"            → all targets at INFO or above
#   "agent=debug"     → only agent target at DEBUG, rest at INFO
#   "agent=trace"     → agent target at TRACE (includes streaming chunks)
#   "warn"            → only WARN and ERROR across all targets
# Levels: error < warn < info < debug < trace
LOOMIS_LOG=agent=debug
